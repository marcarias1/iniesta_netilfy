---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/article.css';
export async function getStaticPaths() {
  const articles = await getCollection('articulos');
  return articles.map(article => ({ params: { slug: article.id }, props: { article } }));
}
interface Props { article: CollectionEntry<'articulos'>; }
const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, author, category, date, thumbnail, externalLinks } = article.data;
const minutes = Math.max(1, Math.ceil((article.body || '').split(/\s+/).length / 200));
---
<Layout title={title} description={description}>
  <article class="reading container">
    <a class="back-link" href="/blog/">← Todos los artículos</a>
    <header class="reading-header"><a class="category" href={`/blog/?categoria=${encodeURIComponent(category)}`}>{category}</a><h1>{title}</h1><p class="standfirst">{description}</p><div class="reading-meta"><span>Por <strong>{author}</strong></span><span aria-hidden="true">·</span><time datetime={date.toISOString()}>{date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time><span aria-hidden="true">·</span><span>{minutes} min de lectura</span></div></header>
    <img class="reading-cover" src={thumbnail} alt="" width="900" height="500" fetchpriority="high" />
    <div class="reading-content"><div class="prose prose-slate"><Content /></div><ExternalLinks links={externalLinks} /><aside class="reading-contact"><Icon name="chat" size={27} /><div><h2>Seguimos aprendiendo contigo</h2><p>¿Tienes una pregunta o una aportación sobre este artículo?</p><a class="text-link" href="/contacto/">Escríbenos <Icon name="arrow" size={16} /></a></div></aside><a class="text-link" href="/blog/">← Seguir explorando artículos</a></div>
  </article>
</Layout>
