---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
const articles = (await getCollection('articulos')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const pillars = [
 { icon: 'book' as const, number: '01', title: 'Conocimiento que se comparte', text: 'Artículos claros y recursos útiles. Acercamos la pedagogía a la vida real, sin complicarla.', link: '/blog/', label: 'Explorar contenidos' },
 { icon: 'leaf' as const, number: '02', title: 'Un futuro con posibilidades', text: 'Hay mucho más allá del aula. Descubre dónde encaja tu vocación y cómo empezar tu camino.', link: '/blog/?categoria=Orientación%20Laboral', label: 'Descubrir salidas' },
 { icon: 'chat' as const, number: '03', title: 'Tus preguntas tienen espacio', text: 'Elegir, empezar, reinventarse… Resolvemos dudas y te acompañamos a dar el siguiente paso.', link: '/faq/', label: 'Resolver mis dudas' },
];
---
<Layout title="La pedagogía tiene mucho que aportar">
  <section class="hero"><div class="container hero-grid">
    <div class="hero-copy"><span class="hero-label"><span></span> LA PEDAGOGÍA, MÁS CERCA DE TI</span><h1>Aprender.<br />Transformar.<br /><span>Dejar huella.</span></h1><p>La pedagogía va mucho más allá del aula.<br class="desktop-break" /> Descubre una profesión que conecta personas,<br class="desktop-break" /> abre caminos y transforma realidades.</p><div class="hero-actions"><a class="button" href="/blog/">Descubre la pedagogía <Icon name="arrow" size={18} /></a><a class="hero-secondary" href="/sobre-nosotros/">Conoce PedaGoGo <span aria-hidden="true">↗</span></a></div><div class="hero-note"><span class="note-check" aria-hidden="true">✓</span> Conocimiento abierto. Sin publicidad. Para todo el mundo.</div></div>
    <div class="hero-visual"><img src="/hero-pedagogia.svg" width="640" height="570" alt="Un brote crece entre las páginas de un libro: aprender para transformar." fetchpriority="high" /><div class="visual-note"><Icon name="spark" size={27} /><span>Pequeñas ideas.<br /><strong>Grandes transformaciones.</strong></span></div><span class="visual-caption">CULTIVAMOS EL POTENCIAL DE LAS PERSONAS</span></div>
  </div></section>
  <div class="manifesto-strip"><div class="container"><span><Icon name="heart" size={17} /> Una iniciativa independiente</span><span><Icon name="book" size={17} /> Pedagogía accesible y práctica</span><span><Icon name="spark" size={17} /> Sin ánimo de lucro, con mucho propósito</span></div></div>
  <section class="section container purpose"><div class="purpose-heading"><div><span class="eyebrow">HAY MUCHO POR DESCUBRIR</span><h2>La pedagogía no es solo enseñar.<br /><span class="muted">Es ayudar a que las cosas cambien.</span></h2></div><p>Somos licenciados en pedagogía con una idea clara: dar a nuestra profesión el lugar que merece. Y hacerlo contigo.</p></div><div class="pillars">{pillars.map((pillar) => <article class="pillar"><div class="pillar-top"><span class="pillar-icon"><Icon name={pillar.icon} size={26} /></span><span>{pillar.number}</span></div><h3>{pillar.title}</h3><p>{pillar.text}</p><a class="text-link" href={pillar.link}>{pillar.label}<Icon name="arrow" size={16} /></a></article>)}</div></section>
  {articles.length > 0 && <section class="latest-section section"><div class="container"><div class="section-heading"><div><span class="eyebrow">IDEAS PARA SEGUIR CRECIENDO</span><h2>Una mirada a la pedagogía</h2></div><a class="text-link" href="/blog/">Todos los artículos <Icon name="arrow" size={16} /></a></div><div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div></div></section>}
  <section class="section container"><div class="consultation-banner"><div class="banner-icon"><Icon name="chat" size={42} /><span aria-hidden="true">✦</span></div><div><span class="eyebrow">NO TE QUEDES CON LA DUDA</span><h2>Cada camino empieza<br />con una buena pregunta.</h2><p>¿Qué puedo hacer con pedagogía? ¿Por dónde empiezo?<br />Consulta nuestras preguntas frecuentes.</p></div><a class="button" href="/faq/">Ver preguntas frecuentes <Icon name="arrow" size={18} /></a></div></section>
  <section class="community container"><div><span class="eyebrow">UN ESPACIO ABIERTO</span><h2>La conversación también transforma.</h2><p>Comparte tus inquietudes, propón un tema o simplemente saluda.<br />Nos encantará escucharte.</p></div><a class="text-link" href="/contacto/">Hablemos <Icon name="arrow" size={18} /></a></section>
</Layout>
<style>
.hero{padding:62px 0 55px;background:linear-gradient(110deg,#fffef9 45%,#fbfaec)}.hero-grid{display:grid;grid-template-columns:1fr .95fr;align-items:center;gap:54px}.hero-label{display:inline-flex;align-items:center;gap:9px;border:1px solid #dedfc9;border-radius:30px;padding:7px 12px;background:#f8f8eb;font-size:.6rem;letter-spacing:.12em;font-weight:600;margin-bottom:24px}.hero-label>span{width:6px;height:6px;border-radius:50%;background:#7b8a5e}.hero h1{font-size:clamp(3.8rem,5.8vw,5.4rem);margin-bottom:23px;line-height:1.04;letter-spacing:-.055em}.hero h1>span{color:#6d7b50;position:relative}.hero h1>span::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:9px;background:#eee0a0;z-index:-1;border-radius:50%}.hero-copy>p{font-size:.96rem;color:#626658;line-height:1.8;margin-bottom:26px}.hero-actions{display:flex;align-items:center;gap:24px}.hero-actions .button{padding:13px 19px;font-size:.79rem;gap:14px}.hero-secondary{font-size:.76rem;font-weight:600;display:flex;gap:12px}.hero-note{font-size:.62rem;color:#69715f;display:flex;align-items:center;gap:7px;margin-top:25px}.note-check{display:inline-flex;border:1px solid #b8c2a5;width:15px;height:15px;align-items:center;justify-content:center;border-radius:50%;font-size:9px}.hero-visual{position:relative;padding-bottom:29px}.hero-visual>img{width:100%;height:auto;border-radius:18px}.visual-note{position:absolute;bottom:58px;left:-31px;display:flex;align-items:center;gap:14px;background:#fffef7;box-shadow:0 5px 24px #3045270e;border:1px solid #e2e2cc;border-radius:10px;padding:16px 22px;transform:rotate(-4deg);font-size:.77rem;line-height:1.65;color:#526044}.visual-note strong{font-weight:600}.visual-caption{position:absolute;bottom:0;left:0;right:0;text-align:center;font-size:.53rem;font-weight:600;letter-spacing:.16em;color:#80866c}.manifesto-strip{border-block:1px solid #e5e6d8;background:#f8f8ee}.manifesto-strip>.container{display:flex;justify-content:space-between;gap:20px;padding-block:20px}.manifesto-strip span{display:flex;gap:11px;align-items:center;font-size:.73rem;color:#5a654e}.manifesto-strip svg{color:#788762}.purpose-heading{display:flex;align-items:end;justify-content:space-between;gap:50px;margin-bottom:38px}.purpose-heading h2{font-size:2.35rem;margin-bottom:0}.purpose-heading>p{max-width:310px;font-size:.85rem;margin-bottom:3px;color:#65705d}.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.pillar{border:1px solid #e1e4d8;border-radius:10px;padding:26px 27px;background:#fff}.pillar-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}.pillar-top>span:last-child{font-size:.66rem;color:#8c927f}.pillar-icon{display:flex;align-items:center;justify-content:center;background:#f3f3e6;border-radius:9px;width:47px;height:47px;color:#6e7e55}.pillar:nth-child(2) .pillar-icon{background:#f9efd9;color:#a37b45}.pillar:nth-child(3) .pillar-icon{background:#eaf0e8;color:#5a7c65}.pillar h3{font-family:var(--font-serif);font-size:1.43rem;max-width:235px;letter-spacing:-.02em;margin-bottom:13px}.pillar p{font-size:.81rem;color:#66705f;line-height:1.8;margin-bottom:23px}.pillar .text-link{font-size:.73rem;border-bottom:0}.latest-section{background:#f6f6ee;border-block:1px solid #e7e8dd}.consultation-banner{background:#f8f1ce;border:1px solid #ece3b9;display:flex;align-items:center;gap:36px;border-radius:15px;padding:42px}.banner-icon{width:95px;height:95px;border-radius:50%;background:#eee3aa;display:flex;align-items:center;justify-content:center;flex:none;color:#63704a;position:relative}.banner-icon>span{position:absolute;top:0;right:0;font-size:26px}.consultation-banner .eyebrow{font-size:.61rem;margin-bottom:15px}.consultation-banner h2{font-size:2.3rem;margin-bottom:16px}.consultation-banner p{font-size:.8rem;color:#66694f;margin-bottom:0}.consultation-banner .button{margin-left:auto;white-space:nowrap;font-size:.78rem}.community{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-bottom:75px}.community .eyebrow{font-size:.65rem}.community h2{font-size:2.3rem;margin-bottom:15px}.community p{font-size:.85rem;color:#626c5a;margin-bottom:0}
@media(max-width:1000px){.hero-grid{gap:35px}.hero-actions{align-items:start;flex-direction:column;gap:17px}.purpose-heading h2{font-size:2rem}.purpose-heading>p{max-width:260px}.consultation-banner{gap:25px;padding:32px}.banner-icon{display:none}.consultation-banner h2{font-size:2rem}}
@media(max-width:760px){.hero{padding:37px 0}.hero-grid{grid-template-columns:minmax(0,1fr);gap:38px}.hero h1{font-size:clamp(2.8rem,13vw,4.2rem)}.hero-label{font-size:.55rem}.hero-copy>p{font-size:.94rem}.hero-actions{flex-direction:row;flex-wrap:wrap;align-items:center;gap:20px}.hero-actions .button{font-size:.72rem;padding:12px 15px}.hero-secondary{font-size:.68rem}.hero-note{font-size:.58rem}.hero-visual{max-width:480px;width:100%;margin-inline:auto}.visual-note{left:8px;bottom:52px;padding:12px 16px;font-size:.72rem}.hero-visual>img{max-height:390px;object-fit:cover}.manifesto-strip>.container{flex-wrap:wrap;justify-content:center;gap:13px 22px;padding-block:18px}.manifesto-strip span{font-size:.63rem}.purpose-heading{flex-direction:column;align-items:start;gap:20px}.purpose-heading h2{font-size:1.95rem}.purpose-heading>p{max-width:100%}.pillars{grid-template-columns:1fr;gap:16px}.pillar{padding:24px}.pillar-top{margin-bottom:18px}.pillar h3{max-width:none}.pillar p{margin-bottom:16px}.consultation-banner{flex-direction:column;align-items:start;padding:27px;gap:25px}.consultation-banner .button{margin-left:0}.consultation-banner h2{font-size:2.1rem}.community{align-items:start;flex-direction:column;padding-bottom:50px;gap:23px}.community h2{font-size:2rem}.latest-section .section-heading{flex-direction:column;gap:18px}.desktop-break{display:none}}
</style>
